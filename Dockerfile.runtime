# Production-style test runtime image built directly from the AgentKit source.
# The image is intentionally self-contained so CI and the test cluster use the
# same binary instead of a workstation-produced artifact.
FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags='-s -w' \
    -o /out/agentkit-runtime ./cmd/internal/adkcli

FROM alpine:3.22

RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 1000 aisphere \
    && adduser -S -D -u 1000 -G aisphere aisphere

WORKDIR /opt/agentkit
COPY --from=build /out/agentkit-runtime /usr/local/bin/agentkit-runtime
COPY adk.test.yaml /opt/agentkit/adk.yaml
COPY agents /opt/agentkit/agents
COPY skills /opt/agentkit/skills

RUN chmod +x /usr/local/bin/agentkit-runtime \
    && mkdir -p /opt/agentkit/.adk/data /opt/agentkit/runtime/sessions \
    && chown -R 1000:1000 /opt/agentkit

USER 1000:1000
ENV ADK_CONFIG=/opt/agentkit/adk.yaml
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/agentkit-runtime"]
