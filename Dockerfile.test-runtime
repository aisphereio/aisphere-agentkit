# Test image for the AgentKit runtime with the native sandbox session path.
# The static binary is built on the release workstation because the test node
# intentionally has no Go proxy egress during Docker builds.
FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 1000 aisphere \
    && adduser -S -D -u 1000 -G aisphere aisphere
WORKDIR /opt/agentkit
COPY agentkit-runtime /usr/local/bin/agentkit-runtime
RUN chmod +x /usr/local/bin/agentkit-runtime
COPY adk.test.yaml /opt/agentkit/adk.yaml
COPY skills /opt/agentkit/skills
RUN mkdir -p /opt/agentkit/.adk/data /opt/agentkit/runtime/sessions \
    && chown -R 1000:1000 /opt/agentkit
USER 1000:1000
ENV ADK_CONFIG=/opt/agentkit/adk.yaml
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/agentkit-runtime"]
