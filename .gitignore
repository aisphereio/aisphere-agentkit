# .gitignore is restricted to the artifacts produced by go build and test.
# for personal setup you can use personal .gitignore: `git config --global core.excludesfile ~/.gitignore`

# Binaries for programs and plugins
agentkit-runtime
agentkit-runtime-*
agentkit-runtime-next
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# ADK local runtime data
.adk/

# Local editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
